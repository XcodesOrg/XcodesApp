    "Access denied. Allow Xcodes Full Disk Access, then rescan." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’ha denegat l’accés. Concedeix a Xcodes accés complet al disc i torna a escanejar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff verweigert. Gewähre Xcodes Festplattenvollzugriff und scanne erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν επιτρέπεται η πρόσβαση. Δώστε στο Xcodes πλήρη πρόσβαση στον δίσκο και σαρώστε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceso denegado. Concede a Xcodes acceso total al disco y vuelve a escanear."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttö estetty. Anna Xcodesille täysi levyn käyttöoikeus ja tarkista uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès refusé. Accordez à Xcodes l’accès complet au disque, puis relancez l’analyse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐक्सेस नहीं मिला। Xcodes को डिस्क का पूरा ऐक्सेस दें और फिर से स्कैन करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesso negato. Concedi a Xcodes l’accesso completo al disco, quindi ripeti la scansione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセスが拒否されました。Xcodesにフルディスクアクセスを許可してから、再スキャンしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "접근이 거부되었습니다. Xcodes에 전체 디스크 접근 권한을 부여한 다음 다시 스캔하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang geweigerd. Geef Xcodes volledige schijftoegang en scan opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odmowa dostępu. Przyznaj aplikacji Xcodes pełny dostęp do dysku, a następnie ponów skanowanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acesso negado. Conceda Acesso Total ao Disco ao Xcodes e escaneie novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ запрещён. Предоставьте Xcodes полный доступ к диску и повторите сканирование."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtkomst nekad. Ge Xcodes full skivtillgång och skanna igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erişim reddedildi. Xcodes’a Tam Disk Erişimi verin ve yeniden tarayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ заборонено. Надайте Xcodes повний доступ до диска, а потім повторіть сканування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "访问被拒绝。请允许 Xcodes 完全访问磁盘，然后重新扫描。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存取遭拒。請授予 Xcodes 完整磁碟存取權限，然後重新掃描。"
          }
        }
      }
    },
