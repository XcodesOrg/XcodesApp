    "Alert.PostInstall.OpenXcode.Message" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تثبيت Xcode %@، لكن بعض خطوات الإعداد لم تكتمل تلقائيًا. افتح Xcode لإكمال الإعداد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode %@ està instal·lat, però alguns passos de configuració no s’han completat automàticament. Obre Xcode per acabar de configurar-lo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode %@ ist installiert, aber einige Einrichtungsschritte wurden nicht automatisch abgeschlossen. Öffne Xcode, um die Einrichtung abzuschließen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Xcode %@ εγκαταστάθηκε, αλλά ορισμένα βήματα διαμόρφωσης δεν ολοκληρώθηκαν αυτόματα. Ανοίξτε το Xcode για να ολοκληρώσετε τη διαμόρφωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode %@ is installed, but some setup steps weren’t completed automatically. Open Xcode to finish setting it up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode %@ está instalado, pero algunos pasos de configuración no se completaron automáticamente. Abre Xcode para terminar de configurarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode %@ on asennettu, mutta kaikkia käyttöönoton vaiheita ei suoritettu automaattisesti. Viimeistele käyttöönotto avaamalla Xcode."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode %@ est installé, mais certaines étapes de configuration ne se sont pas terminées automatiquement. Ouvrez Xcode pour terminer sa configuration."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode %@ इंस्टॉल है, लेकिन सेटअप के कुछ चरण अपने आप पूरे नहीं हुए। सेटअप पूरा करने के लिए Xcode खोलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode %@ è installato, ma alcuni passaggi di configurazione non sono stati completati automaticamente. Apri Xcode per completare la configurazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode %@ はインストールされていますが、一部の設定手順が自動で完了しませんでした。Xcode を開いて設定を完了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode %@이(가) 설치되었지만 일부 설정 단계가 자동으로 완료되지 않았습니다. Xcode를 열어 설정을 마치십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode %@ is geïnstalleerd, maar sommige configuratiestappen zijn niet automatisch voltooid. Open Xcode om de configuratie af te ronden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode %@ jest zainstalowane, ale niektóre etapy konfiguracji nie zostały ukończone automatycznie. Otwórz Xcode, aby dokończyć konfigurację."
          }
        },
        "pt-BR" : {
