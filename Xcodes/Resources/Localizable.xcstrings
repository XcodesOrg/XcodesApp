    "Alert.NoActiveXcode.Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب إزالة %1$@ أداة simctl المضمّنة في Xcode. مجلد أدوات التطوير النشط هو %2$@، ولا يحتوي عليها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per eliminar %1$@ es fa servir simctl, que s’inclou amb Xcode. El directori de desenvolupament actiu és %2$@ i no conté aquesta eina."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Entfernen von %1$@ wird simctl verwendet, das zu Xcode gehört. Das aktive Entwicklerverzeichnis %2$@ enthält dieses Tool nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για την αφαίρεση του %1$@ χρησιμοποιείται το simctl, το οποίο περιλαμβάνεται στο Xcode. Ο ενεργός κατάλογος εργαλείων ανάπτυξης είναι ο %2$@ και δεν περιέχει το simctl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removing %1$@ uses simctl, which comes with Xcode. The active developer directory is %2$@, which doesn't include it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para eliminar %1$@ se usa simctl, que viene con Xcode. El directorio de desarrollo activo es %2$@ y no contiene esta herramienta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohteen %1$@ poistamiseen käytetään Xcoden mukana tulevaa simctl-työkalua. Aktiivinen kehittäjähakemisto on %2$@, eikä se sisällä tätä työkalua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression de %1$@ utilise simctl, fourni avec Xcode. Le répertoire de développement actif est %2$@ et ne contient pas cet outil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ को हटाने के लिए simctl का उपयोग होता है, जो Xcode के साथ आता है। सक्रिय डेवलपर डायरेक्टरी %2$@ है, जिसमें यह टूल नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per rimuovere %1$@ viene usato simctl, incluso in Xcode. La directory di sviluppo attiva è %2$@ e non contiene questo strumento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ の削除には、Xcode に含まれる simctl が必要です。現在アクティブなデベロッパディレクトリ %2$@ には simctl が含まれていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@을(를) 제거하려면 Xcode에 포함된 simctl이 필요합니다. 현재 활성 개발자 디렉토리인 %2$@에는 이 도구가 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor het verwijderen van %1$@ wordt simctl gebruikt, dat bij Xcode wordt geleverd. De actieve ontwikkelaarsmap is %2$@ en bevat dit hulpmiddel niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie %1$@ wymaga narzędzia simctl, które jest częścią Xcode. Aktywny katalog narzędzi programistycznych to %2$@ i nie zawiera tego narzędzia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para remover %1$@, é usado o simctl, que vem com o Xcode. O diretório de desenvolvimento ativo é %2$@ e não inclui essa ferramenta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для удаления %1$@ используется инструмент simctl, который входит в состав Xcode. Активный каталог инструментов разработчика — %2$@. В нём нет simctl."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borttagning av %1$@ använder simctl, som ingår i Xcode. Den aktiva utvecklarkatalogen är %2$@ och innehåller inte verktyget."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การลบ %1$@ ใช้ simctl ซึ่งมาพร้อมกับ Xcode ไดเรกทอรีเครื่องมือสำหรับนักพัฒนาที่ใช้งานอยู่คือ %2$@ ซึ่งไม่มีเครื่องมือนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kaldırılırken Xcode ile gelen simctl kullanılır. Etkin geliştirici dizini %2$@ bu aracı içermiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для видалення %1$@ використовується simctl, що входить до складу Xcode. Активний каталог інструментів розробника %2$@ не містить цього інструмента."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除 %1$@ 需要使用 Xcode 自带的 simctl。当前使用的开发者目录为 %2$@，其中不包含此工具。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除 %1$@ 需要使用 Xcode 隨附的 simctl。目前使用的開發者目錄是 %2$@，其中未包含此工具。"
          }
        }
      }
    },
    "Alert.NoActiveXcode.NoneInstalled" : {
      "extractionState" : "manual",
