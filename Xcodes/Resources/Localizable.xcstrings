    "Open Clean Up to view progress or review failures. Cleanup continues when its window is closed." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obre Neteja per veure el progrés o revisar els errors. La neteja continua quan la seva finestra està tancada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie Aufräumen, um Fortschritte zu sehen oder Fehler zu überprüfen. Aufräumen wird fortgesetzt, wenn das Fenster geschlossen ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε το Εκκαθάριση για να δείτε την πρόοδο ή να αναθεωρήσετε τις αποτυχίες. Το Εκκαθάριση συνεχίζεται όταν το παράθυρο είναι κλειστό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Limpieza para ver el progreso o revisar los fallos.La limpieza continúa cuando su ventana se cierra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa Siivous nähdäksesi edistymistä tai tarkistamaan epäonnistumisia. Siivous jatkuu, kun ikkuna on suljettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Nettoyage pour voir les progrès ou réviser les échecs. Le nettoyage se poursuit lorsque sa fenêtre est fermée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रगति या विफलताओं की समीक्षा करने के लिए सफाई खोलें. सफाई तब जारी रहती है जब खिड़की बंद हो जाती है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Pulizia per visualizzare i progressi o per esaminare gli errori.La pulizia prosegue quando la finestra è chiusa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進歩を表示または失敗をレビューするために クリーンアップ を開きます. クリーンアップ は、そのウィンドウが閉まるときに継続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 또는 실패를 검토하려면 정리을 열어보십시오. 정리은 창이 닫혀있을 때 계속됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Opschonen om vooruitgang te bekijken of fouten te beoordelen. Opschonen gaat door wanneer het venster gesloten is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Czyszczenie, aby wyświetlić postęp lub przeglądać błędy. Czyszczenie trwa, gdy okno jest zamknięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra Limpeza para ver progressos ou revisar falhas. Limpeza continua quando a janela é fechada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте Очистка для просмотра прогресса или пересмотра ошибок. Очистка продолжается, когда окно закрыто."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna Rensning för att se framsteg eller granska misslyckanden. Rensning fortsätter när fönstret är stängt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelişmeleri görmek veya başarısızlıkları incelemek için Temizleme'u açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрийте Очищення, щоб переглянути прогрес або переглянути помилки. Чистка продовжується, коли її вікно закрито."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开清理,以查看进展或审查故障.清理在窗口关闭时继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟清理,以檢視進展或審查故障.清理在視窗關閉時繼續。"
          }
        }
      }
    },
