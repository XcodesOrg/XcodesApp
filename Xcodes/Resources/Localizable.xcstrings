    "Partial size. Increase the scan depth in Folders or resolve unreadable entries for a complete scan." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per completar l'escaneig, augmentar la profunditat de l'escaneig de la carpeta o permetre l'accés als arxius no llegibles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um die Scan abzuschließen, erhöhen Sie die Folder-Scan Tiefe oder erlauben Sie Zugang zu unlesbaren Dateien."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να ολοκληρώσετε τη σάρωση, αυξήστε το βάθος της σάρωσης φάκελου ή επιτρέψτε την πρόσβαση σε μη αναγνώσιμα αρχεία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para completar el escaneo, aumentar la profundidad del escaneo de la pasta o permitir el acceso a los archivos que no se pueden leer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos haluat suorittaa skannauksen, lisätä skannauksen syvyyden tai sallia pääsyn lukemattomiin tiedostoihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour compléter le scan, augmenter la profondeur de scan du dossier ou permettre l'accès à des fichiers non lisibles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्कैन को पूरा करने के लिए, फ़ोल्डर स्कैन की गहराई बढ़ाएं या अनगिनत फ़ाइलों तक पहुंच की अनुमति दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per completare la scansione, aumentare la profondità della scansione della cartella o consentire l'accesso ai file non leggibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャンを完了するには、フォルダースキャンの深さを増やしたり、読み取れないファイルへのアクセスを許可したりします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스캔을 완료하려면 폴더 스캔 깊이를 늘리거나 읽을 수없는 파일에 대한 액세스를 허용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om de scan te voltooien, verhoogt u de scan diepte van de map of toelaat u toegang tot onleesbare bestanden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zakończyć skanowanie, zwiększyć głębokość skanowania folderu lub umożliwić dostęp do nieczytelnych plików."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para concluir o escaneamento, aumentar a profundidade de escaneamento da pasta ou permitir o acesso a arquivos inesquecíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы завершить сканирование, увеличить глубину сканирования папки или разрешить доступ к нечитаемым файлам."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att slutföra skanningen, öka skanningsdjupet i mappen eller tillåta åtkomst till okända filer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanı tamamlamak için, klasörün tarama derinliğini arttırın veya okunamaz dosyalarına erişmenize izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб завершити сканування, збільшити глибину сканування папки або дозволити доступ до нечистих файлів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
