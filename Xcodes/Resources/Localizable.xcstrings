    "Alert.Update.AuthError.Message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض مصدر بيانات Apple إصدارات Xcode المتاحة عبر حساب مطوّري Apple الخاص بك، لذا يلزم تسجيل الدخول. سجّل الدخول لتحديث القائمة أو بدّل المصدر إلى Xcode Releases في الإعدادات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La font de dades d’Apple mostra les versions d’Xcode del teu compte d’Apple Developer, per això cal iniciar-hi sessió. Inicia la sessió per actualitzar la llista o canvia la font de dades a Xcode Releases a la configuració."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenquelle von Apple zeigt Xcode-Versionen aus deinem Apple-Developer-Konto an und erfordert deshalb eine Anmeldung. Melde dich an, um die Liste zu aktualisieren, oder wechsle in den Einstellungen zur Datenquelle Xcode Releases."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πηγή δεδομένων της Apple εμφανίζει τις εκδόσεις Xcode από τον λογαριασμό σας στο Apple Developer και απαιτεί σύνδεση. Συνδεθείτε για να ανανεώσετε τη λίστα ή επιλέξτε την πηγή Xcode Releases στις Ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Apple data source lists Xcode releases from your Apple Developer account, so it needs you to be signed in. Sign in to refresh the list, or switch the data source to Xcode Releases in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fuente de datos de Apple muestra las versiones de Xcode de tu cuenta de Apple Developer, por lo que requiere iniciar sesión. Inicia sesión para actualizar la lista o cambia la fuente de datos a Xcode Releases en Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applen tietolähde näyttää Apple Developer -tilisi Xcode-julkaisut, joten se edellyttää kirjautumista. Päivitä luettelo kirjautumalla sisään tai vaihda asetuksissa tietolähteeksi Xcode Releases."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source de données Apple affiche les versions de Xcode de votre compte Apple Developer et nécessite donc une connexion. Connectez-vous pour actualiser la liste, ou choisissez la source de données Xcode Releases dans les réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple डेटा स्रोत आपके Apple Developer खाते में उपलब्ध Xcode रिलीज़ दिखाता है, इसलिए साइन इन करना ज़रूरी है। सूची रीफ़्रेश करने के लिए साइन इन करें या सेटिंग्स में डेटा स्रोत को Xcode Releases पर बदलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fonte dati Apple mostra le versioni di Xcode disponibili per il tuo account Apple Developer e richiede l’accesso. Accedi per aggiornare l’elenco oppure seleziona Xcode Releases come fonte dati nelle impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple のデータソースでは Apple Developer アカウントで利用できる Xcode のリリースを表示するため、サインインが必要です。一覧を更新するにはサインインするか、設定でデータソースを Xcode Releases に切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 데이터 소스는 Apple Developer 계정의 Xcode 릴리스를 표시하므로 로그인이 필요합니다. 목록을 새로 고치려면 로그인하거나 설정에서 데이터 소스를 Xcode Releases로 변경하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gegevensbron van Apple toont Xcode-releases uit je Apple Developer-account. Daarom moet je inloggen. Log in om de lijst te vernieuwen of kies in Instellingen de gegevensbron Xcode Releases."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Źródło danych Apple wyświetla wydania Xcode z Twojego konta Apple Developer, dlatego wymaga zalogowania. Zaloguj się, aby odświeżyć listę, albo wybierz w ustawieniach źródło Xcode Releases."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fonte de dados da Apple lista as versões do Xcode disponíveis na sua conta Apple Developer e exige que você inicie sessão. Inicie sessão para atualizar a lista ou selecione Xcode Releases como fonte de dados nos ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Источник данных Apple показывает выпуски Xcode из вашей учётной записи Apple Developer и требует входа в неё. Войдите, чтобы обновить список, или выберите источник Xcode Releases в настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples datakälla visar Xcode-versioner från ditt Apple Developer-konto och kräver därför inloggning. Logga in för att uppdatera listan eller byt till datakällan Xcode Releases i inställningarna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แหล่งข้อมูล Apple แสดงรุ่น Xcode จากบัญชี Apple Developer ของคุณ จึงต้องลงชื่อเข้าใช้ ลงชื่อเข้าใช้เพื่อรีเฟรชรายการ หรือเปลี่ยนแหล่งข้อมูลเป็น Xcode Releases ในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple veri kaynağı, Apple Developer hesabınızdaki Xcode sürümlerini listeler ve giriş yapmanızı gerektirir. Listeyi yenilemek için giriş yapın veya Ayarlar’da veri kaynağını Xcode Releases olarak değiştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Джерело даних Apple показує випуски Xcode, доступні у вашому обліковому записі Apple Developer, тому вимагає входу. Увійдіть, щоб оновити список, або виберіть у налаштуваннях джерело Xcode Releases."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 数据源会列出你的 Apple Developer 帐户可用的 Xcode 版本，因此需要登录。请登录以刷新列表，或在设置中将数据源切换为 Xcode Releases。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 資料來源會列出你的 Apple Developer 帳號可使用的 Xcode 版本，因此需要登入。請登入以重新整理列表，或在設定中將資料來源切換為 Xcode Releases。"
          }
        }
      }
    },
