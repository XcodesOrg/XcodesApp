    "Some sharing or metadata could not be fully accounted for." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'estimació no podia comptar plenament per alguns metadats d'emmagatzematge compartit o fitxers."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schätzung konnte nicht vollständig für einige gemeinsame Speicher- oder Dateimethadaten Rechnung tragen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εκτίμηση δεν θα μπορούσε να λογοδοτήσει πλήρως για κάποια κοινή αποθήκευση ή μεταδεδομένα αρχείων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La estimación no podría contar plenamente con algunos almacenes compartidos o metadatos de archivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arvio ei voinut ottaa täysimääräisesti huomioon joitakin jaettua tallennusta tai tiedoston metatietoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'estimation ne pouvait pas compter pleinement sur certains stockage partagés ou les métadonnées de fichier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमान कुछ साझा भंडारण या फ़ाइल मेटाडेटा के लिए पूरी तरह से गणना नहीं कर सकता था।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La stima non poteva rispondere pienamente ad alcuni memorizzamenti condivisi o metadati di file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推定は、いくつかの共有ストレージやファイルメタデータを完全に計算することはできませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추정치는 일부 공유 저장소 또는 파일 메타 데이터에 대해 완전히 책임을 지지 못했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De schatting kon niet volledig rekening houden met sommige gedeelde opslag of bestandmetadata."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szacunek nie mógł w pełni uwzględniać niektórych udostępnionych danych magazynowych lub metadanych plików."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A estimativa não poderia contar plenamente com alguns arquivos de armazenamento ou metadados compartilhados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценка не могла полностью рассчитывать на некоторые совместные хранилища или метаданные файлов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppskattningen kunde inte fullt ut ta hänsyn till vissa delade lagring eller filmetadata."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahmin, bazı paylaşılan depolama veya dosya metadata için tam olarak hesaplanamazdı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оцінка не могла повністю розраховувати на деякі спільні зберігання або метадані файлів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "估计可能无法完全计算某些共享存储或文件代数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "估計可能無法完全計算某些共享儲存或檔案代資料。"
          }
        }
      }
    },
